digraph G {
  graph [bgcolor="white", fontname="Helvetica", fontsize=11, pad=0.2, nodesep=0.35, ranksep=0.45];
  node  [shape=box, style="rounded,filled", fontname="Helvetica", fontsize=11,
         color="#475569", fillcolor="#f1f5f9", penwidth=1.2, margin="0.12,0.06"];
  edge  [color="#475569", fontname="Helvetica", fontsize=10, arrowsize=0.7];

  // Constructors are type nodes (green); variables are neutral; the unifier
  // (a substitution, i.e. a program transformation on types) is orange.
  subgraph cluster_left {
    label="?0 → Int"; fontname="Helvetica"; fontsize=11; color="#cbd5e1"; style=rounded;
    l  [label="→", fillcolor="#dcfce7", color="#15803d"];
    l0 [label="?0"];
    li [label="Int", fillcolor="#dcfce7", color="#15803d"];
    l -> l0 [label=" arg"];
    l -> li [label=" result"];
  }
  subgraph cluster_right {
    label="Bool → ?1"; fontname="Helvetica"; fontsize=11; color="#cbd5e1"; style=rounded;
    r  [label="→", fillcolor="#dcfce7", color="#15803d"];
    rb [label="Bool", fillcolor="#dcfce7", color="#15803d"];
    r1 [label="?1"];
    r -> rb [label=" arg"];
    r -> r1 [label=" result"];
  }

  u [label="most general unifier\n?0 := Bool,  ?1 := Int", fillcolor="#ffedd5", color="#c2410c"];
  l0 -> u [style=dashed, label=" ?0 meets Bool"];
  r1 -> u [style=dashed, label=" ?1 meets Int"];

  subgraph cluster_result {
    label="common instance: Bool → Int"; fontname="Helvetica"; fontsize=11; color="#cbd5e1"; style=rounded;
    c  [label="→", fillcolor="#dcfce7", color="#15803d"];
    cb [label="Bool", fillcolor="#dcfce7", color="#15803d"];
    ci [label="Int", fillcolor="#dcfce7", color="#15803d"];
    c -> cb;
    c -> ci;
  }
  u -> c [label=" apply to\n either side"];
}
