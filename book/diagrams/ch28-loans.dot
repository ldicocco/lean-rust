digraph G {
  graph [bgcolor="white", fontname="Helvetica", fontsize=11, pad=0.2, nodesep=0.35, ranksep=0.3];
  node  [shape=box, style="rounded,filled", fontname="Helvetica", fontsize=11,
         color="#475569", fillcolor="#f1f5f9", penwidth=1.2, margin="0.12,0.06"];
  edge  [color="#475569", fontname="Helvetica", fontsize=10, arrowsize=0.7];

  s0 [label="ℓ0 ↦ 0, not lent"];
  s1 [label="ℓ0 ↦ 0, 1, 2\nlent mut", fillcolor="#fee2e2", color="#b91c1c"];
  s2 [label="ℓ0 ↦ 2, not lent"];
  s3 [label="ℓ0 ↦ 2\nlent shared", fillcolor="#dbeafe", color="#1d4ed8"];
  s4 [label="ℓ0 ↦ 2, not lent"];
  s5 [label="ℓ0 freed", shape=plaintext, style=""];

  s0 -> s1 [label="  E-BorrowMut (step 3)"];
  s1 -> s1 [label="  E-Reborrow, E-Assign,\n  E-EndReborrow (steps 4-10)"];
  s1 -> s2 [label="  E-EndBorrow (step 12)"];
  s2 -> s3 [label="  E-Borrow (step 14)"];
  s3 -> s3 [label="  E-Deref (step 15)"];
  s3 -> s4 [label="  E-EndBorrow (step 16)"];
  s4 -> s5 [label="  E-Drop (step 18)"];
}
