digraph G {
  graph [bgcolor="white", fontname="Helvetica", fontsize=11, pad=0.2, nodesep=0.35, ranksep=0.45];
  node  [shape=box, style="rounded,filled", fontname="Helvetica", fontsize=11,
         color="#475569", fillcolor="#f1f5f9", penwidth=1.2, margin="0.12,0.06"];
  edge  [color="#475569", fontname="Helvetica", fontsize=10, arrowsize=0.7];

  copy  [label="Copy\nimplicit, free contraction (a bitwise copy)\ni32, bool, (i32, char), &T, Point",
         fillcolor="#dcfce7", color="#15803d"];
  clone [label="Clone\nexplicit contraction: x.clone()\nString, Vec<T>, Rc<T>, Reading",
         fillcolor="#dcfce7", color="#15803d"];
  aff   [label="every type: affine\nmove it once, or drop it\nFile, &mut T, closures, Token",
         fillcolor="#fee2e2", color="#b91c1c"];
  bang  [label="!A in linear logic\npromotion, dereliction,\nweakening, contraction",
         fillcolor="#dbeafe", color="#1d4ed8"];

  copy -> clone [label="  every Copy type is Clone"];
  clone -> aff  [label="  every Clone type is still affine:\n  without .clone(), a use moves it"];
  bang -> copy  [style=dashed, label="  ≈"];
}
