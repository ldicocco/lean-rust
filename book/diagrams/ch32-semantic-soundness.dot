digraph G {
  graph [bgcolor="white", fontname="Helvetica", fontsize=11, pad=0.2, nodesep=0.45, ranksep=0.55, rankdir=LR];
  node  [shape=box, style="rounded,filled", fontname="Helvetica", fontsize=11,
         color="#475569", fillcolor="#f1f5f9", penwidth=1.2, margin="0.12,0.06"];
  edge  [color="#475569", fontname="Helvetica", fontsize=10, arrowsize=0.7];

  client [label="client code\n(safe Rust)", fillcolor="#ffedd5", color="#c2410c"];
  syn    [label="syntactic typing\n(a derivation exists)", fillcolor="#dbeafe", color="#1d4ed8"];
  lib    [label="library with unsafe\n(split_at_mut, Cell, Vec)", fillcolor="#fee2e2", color="#b91c1c"];
  sem    [label="semantic typing\n(types as predicates)", fillcolor="#dbeafe", color="#1d4ed8"];
  safe   [label="the linked program\nnever goes wrong", fillcolor="#dcfce7", color="#15803d"];

  client -> syn [label="type checker"];
  syn -> sem [label="fundamental theorem\n(once, for all programs)"];
  lib -> sem [label="manual proof\n(once per library)"];
  sem -> safe [label="adequacy"];
}
