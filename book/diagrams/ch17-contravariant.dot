digraph G {
  graph [bgcolor="white", fontname="Helvetica", fontsize=11, pad=0.2, nodesep=1.4, ranksep=0.8];
  node  [shape=plaintext, fontname="Helvetica", fontsize=12, fontcolor="#15803d"];
  edge  [color="#c2410c", fontname="Helvetica", fontsize=10, arrowsize=0.7, fontcolor="#c2410c"];

  { rank=same; S [label="String"]; N [label="ℕ"]; }
  { rank=same; PS [label="Pred String"]; PN [label="Pred ℕ"]; }

  S -> N [label="len"];
  PS -> PN [dir=back, label="contramap len"];

  S -> PS [style=dashed, color="#7e22ce", fontcolor="#7e22ce", label="Pred"];
  N -> PN [style=dashed, color="#7e22ce", fontcolor="#7e22ce", label="Pred"];
}
