digraph G {
  graph [bgcolor="white", fontname="Helvetica", fontsize=11, pad=0.2, nodesep=0.5, ranksep=0.45];
  node  [shape=box, style="rounded,filled", fontname="Helvetica", fontsize=11,
         color="#475569", fillcolor="#f1f5f9", penwidth=1.2, margin="0.12,0.06"];
  edge  [color="#475569", fontname="Helvetica", fontsize=10, arrowsize=0.7, dir=none];

  bi     [label="bivariant\nparameter unused", fillcolor="#f1f5f9"];
  co     [label="covariant\n&'a T, Box<T>, fn() -> T", fillcolor="#dcfce7", color="#15803d"];
  contra [label="contravariant\nfn(T)", fillcolor="#dbeafe", color="#1d4ed8"];
  inv    [label="invariant\n&mut T, Cell<T>, *mut T", fillcolor="#fee2e2", color="#b91c1c"];

  bi -> co;
  bi -> contra;
  co -> inv;
  contra -> inv;
}
