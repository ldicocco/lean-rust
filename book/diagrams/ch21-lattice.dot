digraph G {
  graph [bgcolor="white", fontname="Helvetica", fontsize=11, pad=0.2, nodesep=0.5, ranksep=0.5];
  node  [shape=box, style="rounded,filled", fontname="Helvetica", fontsize=11,
         color="#1d4ed8", fillcolor="#dbeafe", penwidth=1.2, margin="0.12,0.06"];
  edge  [color="#475569", fontname="Helvetica", fontsize=10, arrowsize=0.7];

  int [label=<<b>intuitionistic</b><br/>exchange, weakening, contraction<br/><font point-size="10">any number of times</font>>];
  aff [label=<<b>affine</b><br/>exchange, weakening<br/><font point-size="10">at most once</font>>];
  rel [label=<<b>relevant</b><br/>exchange, contraction<br/><font point-size="10">at least once</font>>];
  lin [label=<<b>linear</b><br/>exchange<br/><font point-size="10">exactly once</font>>];
  ord [label=<<b>ordered</b> (Lambek)<br/>no structural rules<br/><font point-size="10">exactly once, in order</font>>];

  rust [label="Rust: owned\nnon-Copy values", fillcolor="#fee2e2", color="#b91c1c"];

  int -> aff [label=" drop contraction"];
  int -> rel [label=" drop weakening"];
  aff -> lin [label=" drop weakening"];
  rel -> lin [label=" drop contraction"];
  lin -> ord [label=" drop exchange"];
  rust -> aff [style=dashed, arrowhead=none];
  {rank=same; aff; rel; rust}
}
