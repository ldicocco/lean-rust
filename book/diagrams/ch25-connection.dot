digraph G {
  graph [bgcolor="white", fontname="Helvetica", fontsize=11, pad=0.2, nodesep=0.35, ranksep=0.6, rankdir=LR];
  node  [shape=box, style="rounded,filled", fontname="Helvetica", fontsize=11,
         color="#475569", fillcolor="#f1f5f9", penwidth=1.2, margin="0.12,0.06"];
  edge  [color="#475569", fontname="Helvetica", fontsize=10, arrowsize=0.7];

  closed [label="Connection<Closed>", fillcolor="#dcfce7", color="#15803d"];
  connected [label="Connection<Connected>", fillcolor="#dcfce7", color="#15803d"];
  auth [label="Connection<Authenticated>", fillcolor="#dcfce7", color="#15803d"];

  closed -> connected [label="connect(self)"];
  connected -> auth [label="login(self, ..)  Ok"];
  connected -> connected [label="login  Err"];
  auth -> auth [label="query(&self)"];
  auth -> connected [label="logout(self)"];
  connected -> closed [label="close(self)"];
  auth -> closed [label="close(self)"];
}
