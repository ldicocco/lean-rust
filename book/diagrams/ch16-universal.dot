digraph G {
  graph [bgcolor="white", fontname="Helvetica", fontsize=11, pad=0.2, nodesep=0.9, ranksep=0.9];
  node  [shape=plaintext, fontname="Helvetica", fontsize=12, fontcolor="#15803d"];
  edge  [color="#c2410c", fontname="Helvetica", fontsize=10, arrowsize=0.7, fontcolor="#c2410c"];

  subgraph cluster_product {
    label="product"; fontcolor="#475569"; color="#cbd5e1"; style="rounded";
    X [label="X"];
    { rank=same; A [label="A"]; P [label="A × B"]; B [label="B"]; }
    A -> P [dir=back, label="fst"];
    P -> B [label="snd"];
    X -> A [label="f"];
    X -> P [label="⟨f, g⟩", style=dashed];
    X -> B [label="g"];
  }

  subgraph cluster_coproduct {
    label="coproduct"; fontcolor="#475569"; color="#cbd5e1"; style="rounded";
    { rank=same; A2 [label="A"]; S [label="A + B"]; B2 [label="B"]; }
    Y [label="X"];
    A2 -> S [label="inl"];
    S -> B2 [dir=back, label="inr"];
    A2 -> Y [label="f"];
    S -> Y [label="[f, g]", style=dashed];
    B2 -> Y [label="g"];
  }
}
